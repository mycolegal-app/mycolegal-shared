{
  "name": "@mycolegal-app/ui",
  "version": "3.0.17",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/admin": {
      "types": "./dist/components/admin/index.d.ts",
      "import": "./dist/components/admin/index.js"
    },
    "./components/help": {
      "types": "./dist/components/help/index.d.ts",
      "import": "./dist/components/help/index.js"
    },
    "./components/i18n": {
      "types": "./dist/components/i18n/index.d.ts",
      "import": "./dist/components/i18n/index.js"
    },
    "./components/layout": {
      "types": "./dist/components/layout/index.d.ts",
      "import": "./dist/components/layout/index.js"
    },
    "./components/manual": {
      "types": "./dist/components/manual/index.d.ts",
      "import": "./dist/components/manual/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./tokens/*": "./tokens/*",
    "./assets/*": "./dist/assets/*",
    "./globals.css": "./globals.css",
    "./tailwind-preset": {
      "types": "./dist/tailwind-preset.d.ts",
      "import": "./dist/tailwind-preset.js",
      "default": "./dist/tailwind-preset.js"
    },
    "./e2e/*.js": "./e2e/*.js",
    "./e2e/*": "./e2e/*.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "build:e2e": "tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run build:e2e"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mycolegal-app/mycolegal-shared.git"
  },
  "files": [
    "dist",
    "e2e",
    "tokens",
    "globals.css",
    "tsconfig.json",
    "tsconfig.e2e.json"
  ],
  "peerDependencies": {
    "@playwright/test": ">=1.40",
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=3"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-link": "^2.10.3",
    "@tiptap/extension-table": "^2.10.3",
    "@tiptap/extension-table-cell": "^2.10.3",
    "@tiptap/extension-table-header": "^2.10.3",
    "@tiptap/extension-table-row": "^2.10.3",
    "@tiptap/react": "^2.10.3",
    "@tiptap/starter-kit": "^2.10.3",
    "@types/turndown": "^5.0.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.468.0",
    "marked": "^12.0.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "next": "^16.3.2",
    "typescript": "^6.0.2",
    "vitest": "^2.1.9"
  },
  "description": "e2e fixtures publicadas como JS compilado (Playwright no transforma .ts dentro de node_modules) — desbloquea imports de @mycolegal-app/ui/e2e/shared-lock-fixture desde specs."
}
