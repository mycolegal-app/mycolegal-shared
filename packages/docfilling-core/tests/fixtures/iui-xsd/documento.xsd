															</xs:element>
															<xs:element name="DESC_RAZON_AUT_MENORES" minOccurs="0">
																<xs:annotation>
																	<xs:documentation>Describimos el motivo de la autorización</xs:documentation>
																</xs:annotation>
																<xs:simpleType>
																	<xs:restriction base="xs:string">
																		<xs:maxLength value="1000"/>
																	</xs:restriction>
																</xs:simpleType>
															</xs:element>
														</xs:sequence>
													</xs:complexType>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="SEPARACION_DIVORCIO" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Indicamos si se trata de una separación o un divorcio (0 - Divorcio, 1-Separación)</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:enumeration value="0"/>
												<xs:enumeration value="1"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="FECHA_DECLARACION_TESTIGOS" type="FECHAType" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Indicamos la fecha de la práctica de la declaración de testigos </xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="VALORES_FISCALES" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Valores Fiscales</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="VALOR_FISCAL" type="IMPORTE_ECONOMICOType" minOccurs="0" maxOccurs="unbounded">
													<xs:annotation>
														<xs:documentation>Valor Fiscal</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="CONS_OMI_NUM_PROT" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Datos constancia omisión</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="FEC_OMI" type="FECHAType" minOccurs="1" maxOccurs="1">
													<xs:annotation>
														<xs:documentation>Fecha del documento omitido</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ES_INTERVALO" type="BOOLEANType" minOccurs="1" maxOccurs="1">
													<xs:annotation>
														<xs:documentation>Indica si se omite solo un documento o un intervalo consecutivo</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="NUM_PROT_INI" minOccurs="1"  maxOccurs="1">
													<xs:annotation>
														<xs:documentation>Número del primer protocolo omitido</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:unsignedInt">
															<xs:minInclusive value="1"/>
															<xs:totalDigits value="6"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="NUM_PROT_FIN" minOccurs="0" maxOccurs="1">
													<xs:annotation>
														<xs:documentation>Número del último protocolo omitido</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:unsignedInt">
															<xs:minInclusive value="1"/>
															<xs:totalDigits value="6"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>									
									<xs:element name="FECHA_SOLICITUD_ACTO" type="FECHAType" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Indicamos la fecha en la que se realizó la solicitud</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="FECHA_REALIZACION_ACTO" type="FECHAType" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Indicamos la fecha en la que se realizó el matrimonio o equivalente</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="TIPO_VECINDAD_DECLARADA" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Indicamos el tipo de declaración de vecindad: (1-Declaración, 2-Conservación</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:maxLength value="1"/>
												<xs:enumeration value="1"/>
												<xs:enumeration value="2"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="TIPO_VECINDAD_APLICA" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Indicamos el tipo de régimen jurídico aplicable: (1-Común, 2-Especial o foral</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:maxLength value="1"/>
												<xs:enumeration value="1"/>
												<xs:enumeration value="2"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>									
									<xs:element name="ERRORS" type="ERRORSType" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Descripción de los errores en la validación de los datos</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="TIPO_DOCUMENTOType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="1"/>
			<xs:enumeration value="2"/>
			<xs:enumeration value="3"/>
			<xs:enumeration value="4"/>
			<xs:enumeration value="5"/>
			<xs:enumeration value="6"/>
			<xs:enumeration value="12"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TIPO_DOCUMENTO_RECTIFICADOType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="1"/>
			<xs:enumeration value="2"/>
			<xs:enumeration value="3"/>
			<xs:enumeration value="4"/>
			<xs:enumeration value="5"/>
			<xs:enumeration value="12"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="NUMERO_DOCUMENTOType">
		<xs:restriction base="xs:unsignedInt">
			<xs:totalDigits value="6"/>
			<xs:minInclusive value="1"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="NUMERO_DOCUMENTO_BISType">
		<xs:restriction base="xs:unsignedInt">
			<xs:totalDigits value="3"/>
			<xs:minInclusive value="1"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="PERIODO_FALLECIMIENTOType">
		<xs:sequence>
			<xs:element name="PERIODO" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Periodo fallecimiento ("1" Anterior a 1970, "2" Posterior a 1970 y superior a 10 años, "3" Inferior a 10 años, "4" Fecha)</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="1"/>
						<xs:enumeration value="2"/>
						<xs:enumeration value="3"/>
						<xs:enumeration value="4"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ANYO" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Año del fallecimiento del causante</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:unsignedInt">
						<xs:totalDigits value="4"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="FECHA" type="FECHAType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Fecha completa del fallecimiento del causante</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LUGAR_FALLECIMIENTO" type="LOCALIZACIONType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Lugar de fallecimiento del causante</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DILIGENCIAType">
		<xs:sequence>
			<xs:element name="AUTORIZADO_POR" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indica quien ha comunicado la diligencia. 1 --> Por mí. 2 --> Comunicado por otro notario</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:integer">
						<xs:enumeration value="1"/>
						<xs:enumeration value="2"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="NOTARIO_DILIGENGIA" type="CODIGO_NOTARIOType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Codigo de Últimas Voluntades del notario que ha comunicado la diligencia</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NOMBRE_NOTARIO_DILIGENCIA" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Nombre del notario que ha comunicado la diligencia</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="STRINGType">
						<xs:maxLength value="130"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="NOTARIA_DILIGENCIA" type="CODIGO_NOTARIAType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Codigo de Catastro de la notaría que ha comunicado la diligencia</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DESCRIPCION_NOTARIA_DILIGENCIA" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Descripción de la notaría que ha comunicado la diligencia</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="STRINGType">
						<xs:maxLength value="65"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="FECHA" type="FECHAType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Fecha de la diligencia</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MOTIVO" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Motivo de la diligencia</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="STRINGType">
						<xs:maxLength value="3000"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DNE_INFOType">
		<xs:sequence>
			<xs:element name="NOMBRE_NOTARIO" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Nombre del notario</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="130"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="CUV" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Código de últimas voluntades del Notario</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:pattern value="[0-9]{7}|A[0-9]{6}"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="FEC_AUT_DNE" type="FECHAType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Fecha del Documento</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NUM_PROT_DNE" type="NUMERO_DOCUMENTOType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Número de protocolo o libro registro</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NUM_PROT_BIS_DNE" type="NUMERO_DOCUMENTO_BISType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Número de protocolo o libro registro bis</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DNE_INFO_EXTType">
		<xs:complexContent>
			<xs:extension base="DNE_INFOType">
				<xs:sequence>
					<xs:element name="TIP_DOC" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Tipo de documento ("1" Protocolo ordinario, "3" Libro registro de pólizas - Sección A, "4" Libro registro de pólizas - Sección B)</xs:documentation>
						</xs:annotation>
						<xs:simpleType>
							<xs:restriction base="xs:string">
								<xs:enumeration value="1"/>
								<xs:enumeration value="3"/>
								<xs:enumeration value="4"/>
							</xs:restriction>
						</xs:simpleType>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:simpleType name="PROFESION_APODERADOType">
		<xs:annotation>
			<xs:documentation>Profesión del apoderado ("1" Procurador, "2" Abogado, "3" Graduado Social, "9" Otros)</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="1"/>
			<xs:enumeration value="2"/>
			<xs:enumeration value="3"/>
			<xs:enumeration value="9"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
