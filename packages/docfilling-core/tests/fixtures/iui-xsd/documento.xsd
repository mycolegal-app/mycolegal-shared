																		<xs:element name="RAZON_SOCIAL_DENOMINACION_ANTERIOR" type="STRINGType" minOccurs="0"/>
																		<xs:element name="FORMA_SOCIAL_DENOMINACION_ANTERIOR" minOccurs="0">
