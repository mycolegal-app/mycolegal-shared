<?xml version="1.0" encoding="UTF-8"?>
<!-- edited with XMLSPY v5 rel. 4 U (http://www.xmlspy.com) by INTI S.L. (INTI S.L.) -->
<xs:schema targetNamespace="http://inti.notariado.org/XML/IU2007" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://inti.notariado.org/XML/IU2007" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:include schemaLocation="comun.xsd"/>
	<xs:include schemaLocation="direccion.xsd"/>
	<xs:include schemaLocation="sujeto.xsd"/>
	<xs:include schemaLocation="objeto.xsd"/>
	<xs:include schemaLocation="operacion.xsd"/>
	<xs:complexType name="DOCUMENTO_NOTARIAL_IUType">
		<xs:sequence>
			<xs:element name="IDE_DOC" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Datos identificativos del documento</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="NUM_EXP_CI" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Número de expediente para las aplicaciones de gestión notarial</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="TIP_DOC" type="TIPO_DOCUMENTOType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Tipo de documento ("1" Protocolo ordinario, "2" Protocolo especial de protestos, "3" Libro registro de pólizas - Sección A, "4" Libro registro de pólizas - Sección B, "5" Protocolo reservado, "6" Borrador de protocolo ordinario, "12" Libro registro de pólizas indubitadas)</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="NUM_DOC" type="NUMERO_DOCUMENTOType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Número de protocolo o libro registro</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="NUM_DOC_BIS" type="NUMERO_DOCUMENTO_BISType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Número de protocolo o libro registro bis</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="FEC_AUT" type="FECHAType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Fecha de autorización</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="PAIS_AUT" type="CODIGO_PAISType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Código de país en el que ha sido autorizado, según la codificación oficial de Países y Territorios aprobada por OM 9-12-99</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="PAIS_AUT_ISO" type="CODIGO_PAIS_ISOType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Código de país en el que ha sido autorizado, según la codificación ISO 3166-1 alpha 3</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="COD_PRV" type="CODIGO_PROVINCIAType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Código INE de la provincia en el que ha sido autorizado</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="COD_MUN" type="CODIGO_MUNICIPIOType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Código INE del municipio en el que ha sido autorizado</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="COD_POB_MJ" type="CODIGO_POBLACION_MJType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Código de población en el que ha sido autorizado, según la codificación del Ministerio de Justicia</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="NOMBRE_POB_MJ" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Nombre de la población correspondiente al COD_POB_MJ</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:maxLength value="200"/>
									<xs:pattern value="[^\r\n\t]*"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="LUGAR_DESCRIPCION" type="STR200Type" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Descripción del lugar o población extranjero en el que ha sido autorizado</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="NUM_FOL" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Número de folios que contiene la escritura o póliza</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:unsignedInt">
									<xs:minInclusive value="1"/>
									<xs:totalDigits value="4"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="NUM_FOL_DIG" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Número de folios que contiene la escritura o póliza digitalizada</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:unsignedInt">
									<xs:minInclusive value="1"/>
									<xs:totalDigits value="4"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="CUV_SUS" type="CODIGO_NOTARIOType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Código de últimas voluntades del Notario sustituto</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="IDIS" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Idiomas del documento</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="IDI" minOccurs="0" maxOccurs="unbounded">
										<xs:annotation>
											<xs:documentation>Idioma ("0" Castellano, "1" Catalán, "2" Gallego, "3" Euskera, "4" Valenciano, "5" Otros)</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:enumeration value="0"/>
												<xs:enumeration value="1"/>
												<xs:enumeration value="2"/>
												<xs:enumeration value="3"/>
												<xs:enumeration value="4"/>
												<xs:enumeration value="5"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="TUR_REP" type="BOOLEANType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Turno de reparto del documento notarial</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="FEC_VEN" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Fecha de vencimiento ("1" Hasta 6 meses, "2" Más de 6 meses)</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:enumeration value="1"/>
									<xs:enumeration value="2"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="AUT_NOT" type="BOOLEANType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Autorización fuera del despacho notarial</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="DOC_REC" type="BOOLEANType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Documento de rectificación</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="REC_DOC" minOccurs="0" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Rectificación de documento</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="NOM_APE_NOT" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Nombre y apellidos del Notario anterior</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="STRINGType">
												<xs:maxLength value="130"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="CUV" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Código de últimas voluntades del Notario anterior</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:pattern value="[0-9]{7}|A[0-9]{6}"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="DES_NOT" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Descripción de la Notaría anterior</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="STRINGType">
												<xs:maxLength value="65"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="COD_CAT" type="CODIGO_NOTARIAType" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Código de catastro de la Notaría anterior</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="NUM_DOC" type="NUMERO_DOCUMENTOType" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Número de protocolo o libro registro anterior</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="TIP_DOC" type="TIPO_DOCUMENTO_RECTIFICADOType" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Tipo de documento ("1" Protocolo ordinario, "2" Protocolo especial de protestos, "3" Libro registro de pólizas - Sección A, "4" Libro registro de pólizas - Sección B, "5" Protocolo reservado, "12" Libro registro de pólizas indubitadas)</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="NUM_DOC_BIS" type="NUMERO_DOCUMENTO_BISType" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Número de protocolo o libro registro bis anterior</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ANO_ANT" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Año anterior</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:unsignedInt">
												<xs:totalDigits value="4"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="ES_POL" type="BOOLEANType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>En los protocolos ordinarios indica si es una póliza</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="MAS_100000" type="BOOLEANType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>En las pólizas indica si tienen la cuantía superior a 100000 euros</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ERRORS" type="ERRORSType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Descripción de los errores en la validación de los datos</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="EXS_DIL" type="BOOLEANType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Indica si existe diligencia</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="DIL" type="DILIGENCIAType" minOccurs="0" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Información de diligencias</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="TIP_DOC_ANTERIOR" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Tipo de documento anterior ("1" Documento notarial, "2" Documento no notarial)</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:enumeration value="1"/>
									<xs:enumeration value="2"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="DESC_DOC_NO_NOTARIAL" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Descripción del documento no notarial</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="STRINGType">
									<xs:maxLength value="150"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="DOC_PUB_ANT_REL" type="BOOLEANType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Indica si existe un documento público anterior relevante (diferente a documento de rectificación)</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="CSV_MAN_TRI" minOccurs="0">
							<xs:annotation>
								<xs:documentation>CSV de la copia con efectos tributarios</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="STRINGType">
									<xs:maxLength value="30"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="SUJS" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Datos relativos a los sujetos</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="NUM_SUJS" type="xs:unsignedInt">
							<xs:annotation>
								<xs:documentation>Número de sujetos que contiene el documento</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="SUJ" minOccurs="0" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Datos del sujeto</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="IDE_SUJ">
										<xs:annotation>
											<xs:documentation>Identificador del sujeto en el documento</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="ID_SECUENCIALType">
												<xs:minExclusive value="0"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="NUM_COLEGIADO_PROCURADOR" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Número de colegiado del procurador</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="STRINGType">
												<xs:maxLength value="64"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="TIP_COM" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Tipo de comparecencia ("1" Otorgantes/Participantes, "2" Comparecientes sin carácter sustantivo, "3" Otros sujetos afectados no otorgantes/participantes)</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:enumeration value="1"/>
												<xs:enumeration value="2"/>
												<xs:enumeration value="3"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="CLA_INT" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Clase de intervención ("1" Testigos, "2" Intérpretes, "3" Prestadores de consentimiento, "4" Sujetos que comparecen a efectos de darse por notificados, "5" Albaceas y contadores, "6" Otros)</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:enumeration value="1"/>
												<xs:enumeration value="2"/>
												<xs:enumeration value="3"/>
												<xs:enumeration value="4"/>
												<xs:enumeration value="5"/>
												<xs:enumeration value="6"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="TIP_AFE" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Tipo de afectado no compareciente ("1" Cónyuge no compareciente para el que se adquiere el derecho, "2" Causante, "3" Comunidad de bienes a cuya actividad que queda afecto el bien o derecho que se adquiere, "4" Otros supuestos, "5" Beneficiario de la cancelación)</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:enumeration value="1"/>
												<xs:enumeration value="2"/>
												<xs:enumeration value="3"/>
												<xs:enumeration value="4"/>
												<xs:enumeration value="5"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="TIP_PER" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Tipo de persona ("1" Persona física, "2" Persona jurídica, "3" Entidad financiera)</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:enumeration value="1"/>
												<xs:enumeration value="2"/>
												<xs:enumeration value="3"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="ES_TRUSTEE" type="BOOLEANType" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Indica si el sujeto es Titular Fiduciario o Trustee</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="PRE_REP" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Presencia y representación ("1" Presente, "2" Representado (1 rpte.), "3" No presente por otorgamiento diferido o ausente, "4" Representado (2 rpte.), "5" Representado (3 rpte.), "6" Representado (4 rpte.), "7" Representado )</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:enumeration value="1"/>
												<xs:enumeration value="2"/>
												<xs:enumeration value="3"/>
												<xs:enumeration value="4"/>
												<xs:enumeration value="5"/>
												<xs:enumeration value="6"/>
												<xs:enumeration value="7"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:choice>
										<xs:element name="PER" minOccurs="0">
											<xs:annotation>
												<xs:documentation>Datos de la persona</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:sequence>
													<xs:element name="DOC_IDE" type="DOCUMENTO_IDENTIDADType" minOccurs="0" maxOccurs="20">
														<xs:annotation>
															<xs:documentation>Datos del documento de identidad</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="NOM" type="NOMBRE_PERSONAType" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Nombre</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="APE1_RAZ_SOC" type="APELLIDOS_PERSONAType" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Primer apellido o razón social</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="APE2" type="APELLIDOS_PERSONAType" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Segundo apellido</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="APE_SOL" type="APELLIDOS_PERSONAType" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Apellido de soltera</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="GENERO" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Género del sujeto</xs:documentation>
														</xs:annotation>
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:enumeration value="V"/>
																<xs:enumeration value="M"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="ESTADO_CIVIL" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Estado civil del sujeto ("0" No consta, "1" Soltero/a, "2" Casado, "3" Separado/a judicialmente, "4" Divorciado/a, "5" Viudo/a)</xs:documentation>
														</xs:annotation>
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:enumeration value="0"/>
																<xs:enumeration value="1"/>
																<xs:enumeration value="2"/>
																<xs:enumeration value="3"/>
																<xs:enumeration value="4"/>
																<xs:enumeration value="5"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="PARIENTES" type="PARIENTESType" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Datos de los parientes del sujeto</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="NUM_NIF_CON" type="NIF_CIFType" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Número de NIF del cónyuge</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="NAC" type="CODIGO_PAISType" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Código de país, según la codificación oficial de Países y Territorios aprobada por OM 9-12-99</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="NAC_ISO" type="CODIGO_PAIS_ISOType" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Código de país, según la codificación ISO 3166-1 alpha 3</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="FEC_NAC" type="FECHAType" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Fecha de nacimiento</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="LUGAR_NAC" type="LOCALIZACIONType" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Lugar de nacimiento</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="PRF" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Profesión</xs:documentation>
														</xs:annotation>
														<xs:simpleType>
															<xs:restriction base="STRINGType">
																<xs:maxLength value="25"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="DOM" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Datos del domicilio</xs:documentation>
														</xs:annotation>
														<xs:complexType>
															<xs:sequence>
																<xs:element name="RES_ESP" type="BOOLEANType" minOccurs="0">
																	<xs:annotation>
																		<xs:documentation>Residencia en España</xs:documentation>
																	</xs:annotation>
																</xs:element>
																<xs:element name="ULT_PRV" type="CODIGO_PROVINCIAType" minOccurs="0">
																	<xs:annotation>
																		<xs:documentation>Código INE de la última provincia donde se ha residido</xs:documentation>
																	</xs:annotation>
																</xs:element>
																<xs:sequence>
																	<xs:element name="DOM_ESP" type="DIRECCION_SUJETOType" minOccurs="0">
																		<xs:annotation>
																			<xs:documentation>Datos del domicilio en España</xs:documentation>
																		</xs:annotation>
																	</xs:element>
																	<xs:element name="DOM_EXT" type="DIRECCION_EXTRANJERAType" minOccurs="0">
																		<xs:annotation>
																			<xs:documentation>Datos del domicilio en el Extranjero</xs:documentation>
																		</xs:annotation>
																	</xs:element>
																</xs:sequence>
															</xs:sequence>
														</xs:complexType>
													</xs:element>
													<xs:element name="PER_FAL" type="PERIODO_FALLECIMIENTOType" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Información de la fecha de fallecimiento del causante</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="COD_POS_CLASE_C" type="CODIGO_POSTALType" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Código postal para sujetos clase C</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="OCP_GRUPO" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Grupo de actividad según OCP</xs:documentation>
														</xs:annotation>
														<xs:simpleType>
															<xs:restriction base="STRINGType">
																<xs:maxLength value="4"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="OCP_ACTIVIDAD" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Actividad según OCP</xs:documentation>
														</xs:annotation>
														<xs:simpleType>
															<xs:restriction base="STRINGType">
																<xs:maxLength value="10"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="PROFESION" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Información sobre la profesión del sujeto</xs:documentation>
														</xs:annotation>
														<xs:complexType>
															<xs:sequence>
																<xs:element name="PROF">
																	<xs:annotation>
																		<xs:documentation>Actividad del sujeto ( "1" Actividad de pesca y uso de embarcaciones, "2" Actividad de suministros informáticos y telefonía móvil o sus componentes, "3" Actividad de importación-exportación, "4" Actividad de compraventa de vehículos usados, "5" Actividad de reciclado y chatarra, "6" Actividad de joyería, obras de arte o antigüedades, "7" Actividad de remisión de fondos y cambio de moneda, "8" Actividades de juego y apuestas, "9" Actividad de importación-exportación, "10" Actividad de joyería, obras de arte o antigüedades, "11" Actividad de remisión de fondos y cambio de moneda, "12" Actividades de representación política o cargos políticos, "99" Otras, "50" No se solicita )</xs:documentation>
																	</xs:annotation>
																	<xs:simpleType>
																		<xs:restriction base="xs:string">
																			<xs:enumeration value="1"/>
																			<xs:enumeration value="2"/>
																			<xs:enumeration value="3"/>
																			<xs:enumeration value="4"/>
																			<xs:enumeration value="5"/>
																			<xs:enumeration value="6"/>
																			<xs:enumeration value="7"/>
																			<xs:enumeration value="8"/>
																			<xs:enumeration value="9"/>
																			<xs:enumeration value="10"/>
																			<xs:enumeration value="11"/>
																			<xs:enumeration value="12"/>
																			<xs:enumeration value="99"/>
																			<xs:enumeration value="50"/>
																		</xs:restriction>
																	</xs:simpleType>
																</xs:element>
																<xs:element name="OTRA_PROF" minOccurs="0">
																	<xs:annotation>
																		<xs:documentation>Descripción de la actividad del sujeto cuando no figura en la lista del nodo PROF</xs:documentation>
																	</xs:annotation>
																	<xs:simpleType>
																		<xs:restriction base="xs:string">
																			<xs:maxLength value="1000"/>
																		</xs:restriction>
																	</xs:simpleType>
																</xs:element>
															</xs:sequence>
														</xs:complexType>
													</xs:element>
													<xs:element name="EMAIL" type="EMAILType" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Dirección de correo electrónico</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="TELEFONO" type="TELEFONOType" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Número de telefono, con posibilidad de informar el prefijo</xs:documentation>
														</xs:annotation>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
										<xs:element name="ENT_FIN" minOccurs="0">
											<xs:annotation>
												<xs:documentation>Datos de la entidad financiera</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:sequence>
													<xs:element name="SICA" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Código SICA de la entidad financiera</xs:documentation>
														</xs:annotation>
														<xs:simpleType>
															<xs:restriction base="STRINGType">
																<xs:length value="4"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
									</xs:choice>
									<xs:element name="REP" minOccurs="0" maxOccurs="100">
										<xs:annotation>
											<xs:documentation>Datos del representante</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="IDE_REP" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Identificador del representante en el sujeto</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="ID_SECUENCIALType">
															<xs:minExclusive value="0"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="DOC_IDE_REP" type="DOCUMENTO_IDENTIDADType" minOccurs="0" maxOccurs="20">
													<xs:annotation>
														<xs:documentation>Datos del documento de identidad</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="NOM" type="NOMBRE_PERSONAType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Nombre</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="APE1" type="APELLIDOS_PERSONAType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Primer apellido</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="APE2" type="APELLIDOS_PERSONAType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Segundo apellido</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="NAC" type="CODIGO_PAISType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Código de país, según la codificación oficial de Países y Territorios aprobada por OM 9-12-99</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="NAC_ISO" type="CODIGO_PAIS_ISOType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Código de país, según la codificación ISO 3166-1 alpha 3</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="CLA_REP" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Clase de representación ("1" Legal, "2" Orgánica, "3" Voluntaria, "4" Incompleta, "5" Verbal o no acreditada, "6" Administración concursal)</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:enumeration value="1"/>
															<xs:enumeration value="2"/>
															<xs:enumeration value="3"/>
															<xs:enumeration value="4"/>
															<xs:enumeration value="5"/>
															<xs:enumeration value="6"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="TIP_REP" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Tipo de representación ejercida ("1" Mediata, "2" Inmediata)</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:enumeration value="1"/>
															<xs:enumeration value="2"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="ORI_REP" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Origen de la representación mediata</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="3000"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="DNE" type="BOOLEANType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Indica si es un documento Notarial Español</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="DNE_INFO" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Información del documento notarial español</xs:documentation>
													</xs:annotation>
													<xs:complexType>
														<xs:complexContent>
															<xs:extension base="DNE_INFOType">
																<xs:sequence>
																	<xs:element name="OBSERVACIONES_MEDIATA" minOccurs="0">
																		<xs:annotation>
																			<xs:documentation>Campo de texto libre</xs:documentation>
																		</xs:annotation>
																		<xs:simpleType>
																			<xs:restriction base="xs:string">
																				<xs:maxLength value="3000"/>
																			</xs:restriction>
																		</xs:simpleType>
																	</xs:element>
																</xs:sequence>
															</xs:extension>
														</xs:complexContent>
													</xs:complexType>
												</xs:element>
												<xs:element name="OTR_DOC" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Otro documento</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="3000"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:sequence>
													<xs:element name="DOM_ESP_REP" type="DIRECCION_SUJETOType" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Datos del domicilio en España</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="DOM_EXT_REP" type="DIRECCION_EXTRANJERAType" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Datos del domicilio en el Extranjero</xs:documentation>
														</xs:annotation>
													</xs:element>
												</xs:sequence>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="PROP_MAY" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Indica la existencia del titular real o propietario mayoritario  ("1" Persona jurídica excepcionada, "2" No existe Titular real, "3" Consta en este instrumento, "4" Consta en instrumento público distinto de éste (posterior a entrada en vigor de Ley 10/2010), "5" Consta en documento privado, "6" Titularidad Real consultada en la BDTR</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:enumeration value="1"/>
												<xs:enumeration value="2"/>
												<xs:enumeration value="3"/>
												<xs:enumeration value="4"/>
												<xs:enumeration value="5"/>
												<xs:enumeration value="6"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="PROPIETARIO" minOccurs="0" maxOccurs="4">
										<xs:annotation>
											<xs:documentation>Identificación del titular real o propietario mayoritario</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="DOC_IDE" minOccurs="0" maxOccurs="20">
													<xs:annotation>
														<xs:documentation>Datos del documento de identidad</xs:documentation>
													</xs:annotation>
													<xs:complexType>
														<xs:sequence>
															<xs:element name="TIP_DOC_IDE" type="TIPO_DOCUMENTO_IDENTIDAD_TITULARType" minOccurs="0">
																<xs:annotation>
																	<xs:documentation>Tipo de documento de identidad ("1" NIF, "2" NIE, "3" Pasaporte, "4" Menores de edad que carezcan de dicho número, "6" Falta de aportación del NIF o NIF aportado pero no válido, "8" Documento de identificación de extranjero, "10" Falta de aportación de NIF o NIE)</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:choice>
																<xs:element name="CIR_AUS" minOccurs="0">
																	<xs:annotation>
																		<xs:documentation>Circunstancias concretas concurrentes de la ausencia del documento de identidad</xs:documentation>
																	</xs:annotation>
																	<xs:simpleType>
																		<xs:restriction base="xs:string">
																			<xs:maxLength value="3000"/>
																		</xs:restriction>
																	</xs:simpleType>
																</xs:element>
																<xs:sequence>
																	<xs:element name="AUS_NIF_CIF_NIE" minOccurs="0">
																		<xs:annotation>
																			<xs:documentation>Circunstancias concretas concurrentes de la ausencia de NIF, CIF y/o NIE ("3" Pasaporte, "4" Menores de edad que carecen de NIF, "8" Documento de identificación de extranjero, "12" Tarjeta de residencia, "13" Cargo público u otros motivos [inválido], "15" Documento de identificación distinto o ausencia de cualquiera de ellos)</xs:documentation>
																		</xs:annotation>
																		<xs:simpleType>
																			<xs:restriction base="xs:string">
																				<xs:enumeration value="3"/>
																				<xs:enumeration value="4"/>
																				<xs:enumeration value="8"/>
																				<xs:enumeration value="12"/>
																				<xs:enumeration value="13"/>
																				<xs:enumeration value="15"/>
																			</xs:restriction>
																		</xs:simpleType>
																	</xs:element>
																	<xs:element name="NUM_DOC_IDE" type="NUMERO_DOCUMENTO_IDENTIDADType" minOccurs="0">
																		<xs:annotation>
																			<xs:documentation>Número del documento de identidad</xs:documentation>
																		</xs:annotation>
																	</xs:element>
																</xs:sequence>
															</xs:choice>
														</xs:sequence>
													</xs:complexType>
												</xs:element>
												<xs:element name="NOM" type="NOMBRE_PERSONAType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Nombre</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="APE1" type="APELLIDOS_PERSONAType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Primer apellido</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="APE2" type="APELLIDOS_PERSONAType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Segundo apellido</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="NAC" type="CODIGO_PAISType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Nacionalidad</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="NAC_ISO" type="CODIGO_PAIS_ISOType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Código de país, según la codificación ISO 3166-1 alpha 3</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="DOCUMENTO_PUBLICO" type="DNE_INFO_EXTType" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Datos del documento público en el que se identifica el titular real de la sociedad</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="TIT_REAL_PER_JUR_EXC" type="BOOLEANType" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Para las sociedades, indica si la sociedad está excepcionada de informar los datos de Titular Real o propietario mayoritario</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="TRUST" type="TRUSTType" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Datos del Trust del que el sujeto es Titular Fiduciario o Trustee</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ERRORS" type="ERRORSType" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Descripción de los errores en la validación de los datos</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="OBJS" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Datos relativos a los objetos</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="NUM_OBJS" type="xs:unsignedInt">
							<xs:annotation>
								<xs:documentation>Número de objetos que contiene el documento</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="OBJ" minOccurs="0" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Datos del objeto</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="IDE_OBJ">
										<xs:annotation>
											<xs:documentation>Identificador del objeto en el documento</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="ID_SECUENCIALType">
												<xs:minExclusive value="0"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="TIP_OBJ" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Tipo de objeto ("1" Fincas urbanas en España, "2" Fincas rústicas en España, "3" Fincas de características especiales en España, "4" Fincas situadas fuera de España, "5" Concesiones administrativas, "6" Acciones, participaciones sociales u obligaciones, "7" Otros objetos, "8" Finca rústica/urbana)</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:enumeration value="1"/>
												<xs:enumeration value="2"/>
												<xs:enumeration value="3"/>
												<xs:enumeration value="4"/>
												<xs:enumeration value="5"/>
												<xs:enumeration value="6"/>
												<xs:enumeration value="7"/>
												<xs:enumeration value="8"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:choice>
										<xs:element ref="FIN_URB" minOccurs="0">
											<xs:annotation>
												<xs:documentation>Datos de la finca urbana</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element ref="FIN_RUS" minOccurs="0">
											<xs:annotation>
												<xs:documentation>Datos de la finca rústica</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="FIN_ESP" minOccurs="0">
											<xs:annotation>
												<xs:documentation>Datos de la finca de características especiales</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:sequence>
													<xs:element name="SUP" type="SUPERFICIEType" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Superficie</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="FIN_ESP_IDE" type="IDENTIFICACION_FINCAType" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Datos de identificación de la finca</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="VAL" type="IMPORTE_ECONOMICOType" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Cuantía de la finca</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="DIR_ESP" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Dirección</xs:documentation>
														</xs:annotation>
														<xs:complexType>
															<xs:sequence>
																<xs:element name="COD_MUN" type="CODIGO_MUNICIPIOType" minOccurs="0">
																	<xs:annotation>
																		<xs:documentation>Código INE del municipio</xs:documentation>
