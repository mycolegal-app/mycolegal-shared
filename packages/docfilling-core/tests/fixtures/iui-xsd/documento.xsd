																				<xs:documentation>
																				("A", "SA - Sociedad Anónima");
																				("B", "SL - Sociedad Limitada");
																				("C", "SC - Sociedad Colectiva");
																				("D", "SCOM - Sociedad Comanditaria");
																				("F", "COOP - Sociedad Cooperativa");
																				("G", "AIE - Agrupación de Interés económico");
																				("U", "UTE - Unión Temporal de empresas");
																				("V", "OTROS - Otros tipos no definidos en el resto de claves")
																				</xs:documentation>
																			</xs:annotation>
																			<xs:simpleType>
																				<xs:restriction base="xs:string">
																					<xs:maxLength value="1"/>
																					<xs:enumeration value="A"/>
																					<xs:enumeration value="B"/>
																					<xs:enumeration value="C"/>
																					<xs:enumeration value="D"/>
																					<xs:enumeration value="F"/>
																					<xs:enumeration value="G"/>
																					<xs:enumeration value="U"/>
																					<xs:enumeration value="V"/>
																				</xs:restriction>
																			</xs:simpleType>
																		</xs:element>
																	</xs:sequence>
																</xs:complexType>
															</xs:element>
														</xs:sequence>
													</xs:complexType>
												</xs:element>
