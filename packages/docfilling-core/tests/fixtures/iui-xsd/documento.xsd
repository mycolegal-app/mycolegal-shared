															<xs:element name="PARTES_TESTAMENTARIOS" minOccurs="0">
																<xs:annotation>
																	<xs:documentation>Datos para el trámite Partes Testamentarios</xs:documentation>
																</xs:annotation>
																<xs:complexType>
																	<xs:sequence>
																		<xs:element name="CLASE_TESTAMENTO" minOccurs="0">
																			<xs:annotation>
																				<xs:documentation>Clase del testamento (1- TESTAMENTO ABIERTO. 2- TESTAMENTO CERRADO. 3- A.P.T. OLOGRAFO. 4- A.P.T. CERRADO. 5- A.P.T. MILITAR. 6- A.P.T. MARITIMO. 7- A.P.T. SOLO ANTE TESTIGOS. 8- A.P.T. SOLO ANTE ECLESIASTICO. 9- PACTO SUCESORIO. 0- OTRAS MODALIDADES. A- MANCOMUNADO. B- ABIERTO MANCOMUNADO. C- NUNCUPATIVO. D- CAPITULOS MATRIMONIALES. E- HEREDAMIENTO PREVENTIVO. F- DONACION MORTIS CAUSA. G- CODICILO. H- CEDULA TESTAMENTARIA. I- TESTAMENTO DE HERMANDAD. J- PODER TESTATORIO. K- OTORGADO POR COMISARIO). Máximo 1 Carácter</xs:documentation>
																			</xs:annotation>
																			<xs:simpleType>
																				<xs:restriction base="STRINGType">
																					<xs:maxLength value="1"/>
																					<xs:pattern value="[0-9A-K]{1}"/>
																				</xs:restriction>
																			</xs:simpleType>
																		</xs:element>
																		<xs:element name="TESTAMENTO_PUPILAR" minOccurs="0">
																			<xs:annotation>
																				<xs:documentation>Se indica el tipo de testamento pupilar (0- NO APLICA; 1 -PUPILAR (MENORES DE 14AÑOS); EJEMPLAR (MAYORES DE 14 DISCAPACITADOS)</xs:documentation>
																			</xs:annotation>
																			<xs:simpleType>
																				<xs:restriction base="STRINGType">
																					<xs:maxLength value="1"/>
																					<xs:enumeration value="0"/>
																					<xs:enumeration value="1"/>
																					<xs:enumeration value="2"/>
																				</xs:restriction>
																			</xs:simpleType>
																		</xs:element>
																	</xs:sequence>
																</xs:complexType>
															</xs:element>
															<xs:element name="ERRORS" type="ERRORSType" minOccurs="0">
